{
  "version": 2,
  "builds": [
    {
      "src": "backend/social_media_manager/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/social_media_manager/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend/social_media_manager/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "social_media_manager.settings_vercel",
    "PYTHONPATH": "backend"
  },
  "functions": {
    "backend/social_media_manager/wsgi.py": {
      "includeFiles": "backend/**"
    }
  }
}