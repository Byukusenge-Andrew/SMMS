      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/auth/social-accounts/:
    get:
      operationId: api_auth_social_accounts_list
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSocialMediaAccountList'
          description: ''
    post:
      operationId: api_auth_social_accounts_create
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SocialMediaAccountRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SocialMediaAccountRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SocialMediaAccountRequest'
        required: true
      security:
      - tokenAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SocialMediaAccount'
          description: ''
  /api/auth/social-accounts/{account_id}/remove/:
    delete:
      operationId: api_auth_social_accounts_remove_destroy
      description: Remove a connected social media account
      parameters:
      - in: path
        name: account_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '204':
          description: No response body
  /api/auth/social-accounts/check/:
    get:
      operationId: api_auth_social_accounts_check_retrieve
      description: Check if a social media account already exists for the user
