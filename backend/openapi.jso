    put:
      operationId: api_collaborators_posts_collaboration_update
      description: API view to manage collaboration for a post
      parameters:
      - in: path
        name: post_id
        schema:
          type: integer
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PostCollaborationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PostCollaborationRequest'
          multipart/form-data:
            schema:
