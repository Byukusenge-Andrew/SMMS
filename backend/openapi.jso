  /api/collaborators/collaborations/{collaboration_id}/reviews/:
    get:
      operationId: api_collaborators_collaborations_reviews_list
      description: API view to list and create reviews for a collaboration
      parameters:
      - in: path
        name: collaboration_id
        schema:
          type: integer
        required: true
      - name: ordering
        required: false
        in: query
