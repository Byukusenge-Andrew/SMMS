              $ref: '#/components/schemas/PatchedPostTemplateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedPostTemplateRequest'
      security:
      - tokenAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PostTemplate'
          description: ''
    delete:
      operationId: api_posts_templates_destroy
      description: Retrieve, update or delete a template
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '204':
          description: No response body
components:
  schemas:
    AutomatedMessage:
      type: object
      properties:
        id:
