    UserProfileRequest:
      type: object
      properties:
        company_name:
          type: string
          maxLength: 255
        avatar:
          type: string
          format: binary
          nullable: true
        subscription_type:
          type: string
          minLength: 1
          maxLength: 20
        time_format:
          $ref: '#/components/schemas/TimeFormatEnum'
        timezone:
          type: string
          minLength: 1
          maxLength: 50
        email_notifications:
          type: boolean
        slack_notifications:
          type: boolean
    UserRegistrationRequest:
      type: object
      properties:
        username:
          type: string
          minLength: 1
          description: Required. 150 characters or fewer. Letters, digits and @/./+/-/_
            only.
          pattern: ^[\w.@+-]+$
          maxLength: 150
        email:
          type: string
          format: email
          title: Email address
          maxLength: 254
        password:
          type: string
          writeOnly: true
          minLength: 1
        password_confirm:
          type: string
          writeOnly: true
          minLength: 1
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
      required:
      - email
      - password
      - password_confirm
      - username
    UserRequest:
      type: object
      properties:
        username:
          type: string
          minLength: 1
          description: Required. 150 characters or fewer. Letters, digits and @/./+/-/_
            only.
          pattern: ^[\w.@+-]+$
          maxLength: 150
        email:
          type: string
          format: email
          title: Email address
          maxLength: 254
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
      required:
      - username
    Workspace:
      type: object
      description: Serializer for Workspace model
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 255
        description:
          type: string
        owner:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        is_active:
          type: boolean
        allow_guest_access:
          type: boolean
        member_count:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - member_count
      - name
      - owner
      - updated_at
    WorkspaceMember:
      type: object
      description: Serializer for WorkspaceMember model
      properties:
        id:
          type: integer
          readOnly: true
        workspace:
          type: integer
        workspace_name:
          type: string
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        role:
          $ref: '#/components/schemas/WorkspaceMemberRoleEnum'
        can_create_posts:
          type: boolean
        can_edit_posts:
          type: boolean
        can_delete_posts:
          type: boolean
        can_publish_posts:
          type: boolean
        can_view_analytics:
          type: boolean
        can_manage_members:
          type: boolean
        joined_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - id
      - joined_at
      - role
      - user
      - workspace
      - workspace_name
    WorkspaceMemberRequest:
      type: object
      description: Serializer for WorkspaceMember model
      properties:
        workspace:
          type: integer
        role:
          $ref: '#/components/schemas/WorkspaceMemberRoleEnum'
        can_create_posts:
          type: boolean
        can_edit_posts:
          type: boolean
        can_delete_posts:
          type: boolean
        can_publish_posts:
          type: boolean
        can_view_analytics:
          type: boolean
        can_manage_members:
          type: boolean
      required:
      - role
      - workspace
    WorkspaceMemberRoleEnum:
      enum:
      - owner
      - admin
      - editor
      - viewer
      - guest
      type: string
      description: |-
        * `owner` - Owner
        * `admin` - Admin
        * `editor` - Editor
        * `viewer` - Viewer
        * `guest` - Guest
    WorkspaceRequest:
      type: object
      description: Serializer for Workspace model
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        description:
          type: string
        is_active:
          type: boolean
        allow_guest_access:
          type: boolean
      required:
      - name
  securitySchemes:
    tokenAuth:
      type: apiKey
      in: header
      name: Authorization
      description: Token-based authentication with required prefix "Token"
