      properties:
        id:
          type: integer
          readOnly: true
        creator:
          type: integer
          readOnly: true
        creator_info:
          type: string
          readOnly: true
        title:
          type: string
          maxLength: 255
        description:
          type: string
        budget:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
        status:
          $ref: '#/components/schemas/Status540Enum'
        target_niches: {}
        min_followers:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
        max_followers:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
        target_platforms: {}
        applications_count:
          type: string
          readOnly: true
        days_remaining:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - applications_count
      - budget
      - created_at
      - creator
      - creator_info
