openapi: 3.0.3
info:
  title: Social Media Manager API
  version: 1.0.0
  description: Comprehensive social media management platform API
paths:
  /api/analytics/ai/competitor-analysis/:
    post:
      operationId: api_analytics_ai_competitor_analysis_create
      description: Analyze competitor performance and provide insights
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/ai/insights/:
    get:
      operationId: api_analytics_ai_insights_retrieve
      description: Get AI-powered insights based on analytics data
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/ai/predict-performance/:
    get:
      operationId: api_analytics_ai_predict_performance_retrieve
      description: Predict content performance using AI
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/ai/recommendations/:
    get:
      operationId: api_analytics_ai_recommendations_retrieve
      description: Get AI-powered content and strategy recommendations
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/best-posts/:
    get:
      operationId: api_analytics_best_posts_retrieve
      description: Get best performing posts
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/collect/:
    post:
      operationId: api_analytics_collect_create
      description: Trigger analytics collection
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/dashboard/:
    get:
      operationId: api_analytics_dashboard_retrieve
      description: Get analytics dashboard data
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/location-heatmap/:
    get:
      operationId: api_analytics_location_heatmap_retrieve
      description: Get location-based analytics for heat map visualization
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/platform-averages/:
    get:
      operationId: api_analytics_platform_averages_retrieve
      description: Get platform averages
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/reels/:
    get:
      operationId: api_analytics_reels_retrieve
      description: Get analytics specifically for reels/video content
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/reports/:
    get:
      operationId: api_analytics_reports_retrieve
      description: Get or generate performance reports
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: api_analytics_reports_create
      description: Get or generate performance reports
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/reports/monthly/:
    get:
      operationId: api_analytics_reports_monthly_retrieve
      description: Get or generate monthly performance report
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/reports/weekly/:
    get:
      operationId: api_analytics_reports_weekly_retrieve
      description: Get or generate weekly performance report
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/reports/yearly/:
    get:
      operationId: api_analytics_reports_yearly_retrieve
      description: Get or generate yearly performance report
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/analytics/sentiment/:
    post:
      operationId: api_analytics_sentiment_create
      description: Analyze comment sentiment for a post
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/auth/dashboard/:
    get:
      operationId: api_auth_dashboard_retrieve
      description: Dashboard data for authenticated user
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/auth/debug-auth/:
    get:
      operationId: api_auth_debug_auth_retrieve
      description: Debug endpoint to check authentication
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/auth/debug-auth-open/:
    get:
      operationId: api_auth_debug_auth_open_retrieve
      description: Open debug endpoint to check what's happening with auth
      tags:
      - api
      security:
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/auth/health/:
    get:
      operationId: api_auth_health_retrieve
      description: Health check endpoint
      tags:
      - api
      security:
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/auth/login/:
    post:
      operationId: api_auth_login_create
      description: Function-based login view
      summary: Login user
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      security:
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: Login successful
        '400':
          description: Validation error
        '401':
          description: Invalid credentials or email not verified
  /api/auth/logout/:
    post:
      operationId: api_auth_logout_create
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/auth/profile/:
    get:
      operationId: update_profile
      description: Update user profile including avatar upload
      summary: Update user profile
      tags:
      - api
      security:
      - tokenAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
              examples:
                ProfileUpdateWithAvatar:
                  value:
                    company_name: Keative
                    subscription_type: premium
                    time_format: 12h
                    timezone: UTC
                    email_notifications: true
                    slack_notifications: true
                  summary: Profile Update with Avatar
                  description: Example profile update with file upload
          description: ''
    put:
      operationId: update_profile_3
      description: Update user profile including avatar upload
      summary: Update user profile
      tags:
      - api
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/UserProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/UserProfileRequest'
          application/json:
            schema:
              $ref: '#/components/schemas/UserProfileRequest'
            examples:
              ProfileUpdateWithAvatar:
                value:
                  company_name: Keative
                  subscription_type: premium
                  time_format: 12h
                  timezone: UTC
                  email_notifications: true
                  slack_notifications: true
                summary: Profile Update with Avatar
                description: Example profile update with file upload
      security:
      - tokenAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
              examples:
                ProfileUpdateWithAvatar:
                  value:
                    company_name: Keative
                    subscription_type: premium
                    time_format: 12h
                    timezone: UTC
                    email_notifications: true
                    slack_notifications: true
                  summary: Profile Update with Avatar
                  description: Example profile update with file upload
          description: ''
    patch:
      operationId: update_profile_2
      description: Update user profile including avatar upload
      summary: Update user profile
      tags:
      - api
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
            examples:
              ProfileUpdateWithAvatar:
                value:
                  company_name: Keative
                  subscription_type: premium
                  time_format: 12h
                  timezone: UTC
                  email_notifications: true
                  slack_notifications: true
                summary: Profile Update with Avatar
                description: Example profile update with file upload
      security:
      - tokenAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
              examples:
                ProfileUpdateWithAvatar:
                  value:
                    company_name: Keative
                    subscription_type: premium
                    time_format: 12h
                    timezone: UTC
                    email_notifications: true
                    slack_notifications: true
                  summary: Profile Update with Avatar
                  description: Example profile update with file upload
          description: ''
  /api/auth/register/:
    post:
      operationId: api_auth_register_create
      summary: Register a new user (email verification)
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
