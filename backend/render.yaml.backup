services:
  - type: web
    name: smms-backend
    runtime: python
    region: oregon
    plan: starter
    buildCommand: './build.sh'
    startCommand: 'python -m gunicorn social_media_manager.asgi:application -k uvicorn.workers.UvicornWorker'
    healthCheckPath: /api/health/
    envVars:
      # Django Core Settings
      - key: SECRET_KEY
        generateValue: true
      - key: DEBUG
        value: "False"
      - key: ALLOWED_HOSTS
        value: "*"
      
      # AWS RDS Database (your existing database)
      - key: DATABASE_URL
        value: "postgres://postgres:andre01ab.@social-media-db.chgyuqs4suf5.eu-north-1.rds.amazonaws.com:5432/postgres?sslmode=require"
      
      # Redis Configuration (using Render Redis service)
      - key: REDIS_URL
        fromDatabase:
          name: smms-redis
          property: connectionString
      - key: CELERY_BROKER_URL
        fromDatabase:
          name: smms-redis
          property: connectionString
      - key: CELERY_RESULT_BACKEND
        fromDatabase:
          name: smms-redis
          property: connectionString
      
      # Email Configuration
      - key: EMAIL_HOST
        value: "smtp.gmail.com"
      - key: EMAIL_PORT
        value: "587"
      - key: EMAIL_USE_TLS
        value: "True"
      - key: EMAIL_HOST_USER
        value: "andrebyukusenge9@gmail.com"
      - key: EMAIL_HOST_PASSWORD
        value: "kxqy raah dhxh kjby"
      - key: DEFAULT_FROM_EMAIL
        value: "andrebyukusenge9@gmail.com"
      
      # Supabase Storage
