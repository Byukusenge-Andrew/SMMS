# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES FOR RENDER (Using AWS Infrastructure)
# =============================================================================
# This file shows the environment variables needed for your Render deployment
# while keeping your existing AWS RDS database and other services

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
SECRET_KEY=generate-this-in-render-dashboard
DEBUG=False
ALLOWED_HOSTS=*

# =============================================================================
# AWS RDS DATABASE (Your existing database)
# =============================================================================
DATABASE_URL=postgres://username:password@your-database-host:5432/database_name?sslmode=require
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=your-database-host.region.rds.amazonaws.com
DB_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Option 1: Use Render Redis (recommended)
# REDIS_URL=redis://red-xxxxx:6379
# CELERY_BROKER_URL=redis://red-xxxxx:6379/0
# CELERY_RESULT_BACKEND=redis://red-xxxxx:6379/0

# Option 2: Use external Redis service (like AWS ElastiCache)
REDIS_URL=redis://your-redis-host:6379/0
CELERY_BROKER_URL=redis://your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/0

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# =============================================================================
# SUPABASE STORAGE (Your existing setup)
# =============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=your-bucket-name

# =============================================================================
# SOCIAL MEDIA API KEYS (Your existing keys)
# =============================================================================
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_KEY_SECRET=your-twitter-api-key-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

REDDIT_CLIENT_ID=your-reddit-client-id

# =============================================================================
# SLACK INTEGRATION (Your existing setup)
# =============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_VERIFICATION_TOKEN=your-slack-verification-token
SLACK_APP_ID=your-slack-app-id

# =============================================================================
# SOCIAL AUTH (Your existing setup)
# =============================================================================
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth2-client-id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth2-client-secret
SOCIAL_AUTH_GITHUB_KEY=your-github-oauth-key
SOCIAL_AUTH_GITHUB_SECRET=your-github-oauth-secret

# =============================================================================
# TWITTER OAUTH 2.0 (Update for production)
# =============================================================================
TWITTER_CLIENT_ID=your-twitter-oauth2-client-id
TWITTER_CLIENT_SECRET=your-twitter-oauth2-client-secret
TWITTER_REDIRECT_URI=https://your-app.onrender.com/api/integrations/twitter/callback/
TWITTER_SCOPES=tweet.read tweet.write users.read offline.access

# =============================================================================
# DJANGO ADMIN SUPERUSER
# =============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=your-admin-email@example.com
DJANGO_SUPERUSER_PASSWORD=generate-secure-password

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
WEB_CONCURRENCY=4

# =============================================================================
# ERROR TRACKING (Optional)
# =============================================================================
SENTRY_DSN=your-sentry-dsn-if-you-want-error-tracking
