					"name": "List Posts",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Posts listed successfully', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/posts/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								""
							]
						}
					}
				},
				{
					"name": "Get Post Detail",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Post detail retrieved successfully', () => {",
