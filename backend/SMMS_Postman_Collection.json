					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/posts/{{test_post_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{test_post_id}}",
								""
							]
						}
					}
				}
			]
		},
		{
			"name": "AI Features",
