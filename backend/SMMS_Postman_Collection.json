					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"comments\": [\n        \"This is amazing!\",\n        \"Great work!\",\n        \"Could be better\",\n        \"Not impressed\",\n        \"Love this content!\"\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/posts/ai/sentiment/post/{{test_post_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"ai",
								"sentiment",
								"post",
								"{{test_post_id}}",
								""
							]
						}
					}
				}
