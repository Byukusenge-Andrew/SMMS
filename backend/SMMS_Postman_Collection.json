							"script": {
								"exec": [
									"pm.test('Sentiment analysis completed', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson.sentiment).to.be.oneOf(['positive', 'negative', 'neutral']);",
									"    pm.expect(responseJson.confidence).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"comment\": \"This is absolutely amazing! I love it so much! 😍\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/posts/ai/sentiment/comment/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"ai",
								"sentiment",
								"comment",
								""
							]
						}
					}
				},
				{
					"name": "Sentiment Analysis - Post Comments",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Bulk sentiment analysis completed', () => {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson.overall_sentiment).to.be.oneOf(['positive', 'negative', 'neutral']);",
									"    pm.expect(responseJson.comments_analyzed).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
